<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#64748B</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SettingsChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">#1E293B</item>
        <item name="chipStrokeColor">#334155</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">#93C5FD</item>
        <item name="checkedChipBackgroundColor">#3B82F6</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconSize">12dp</item>
    </style>

    <style name="SettingsCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#0F172A</item>
        <item name="strokeColor">#334155</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">#334155</item>
    </style>

    <style name="ToggleSwitch" parent="Theme.MaterialComponents.DayNight">
        <item name="colorControlActivated">#3B82F6</item>
    </style>
</resources>
